          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"password\",\n  \"length\": 24,\n  \"symbols\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/generate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Password aleatoria', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(json.kind).to.eql('password');",
                  "    pm.expect(json.length).to.eql(24);",
                  "    pm.expect(json.value).to.have.lengthOf(24);",
                  "    pm.expect(json.value).to.match(/[A-Z]/);",
                  "    pm.expect(json.value).to.match(/[a-z]/);",
                  "    pm.expect(json.value).to.match(/[0-9]/);",
                  "});",
                  "if (json.value) {",
                  "    pm.collectionVariables.set('generatedPassword', json.value);",
                  "}"
                ]
              }
            }
          ]
        },
