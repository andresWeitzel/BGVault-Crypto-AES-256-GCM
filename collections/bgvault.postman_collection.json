  "item": [
    {
      "name": "Health",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 y OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('OK');",
                  "    pm.expect(json.auth).to.eql('jwt');",
                  "    pm.expect(json.crypto).to.eql('envelope');",
                  "    pm.expect(json).to.have.property('timestamp');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
