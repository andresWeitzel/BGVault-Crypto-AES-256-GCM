              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'other-' + Date.now() + '@bgvault.local';",
                  "pm.collectionVariables.set('otherEmail', email);",
                  "pm.request.body.raw = JSON.stringify({ email: email, password: 'other-password-1' });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Segundo usuario', function () {",
