  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "otherAccessToken", "value": "" },
    { "key": "authEmail", "value": "demo@bgvault.local" },
    { "key": "authPassword", "value": "bgvault-dev-password" },
