              "raw": "{\n  \"type\": \"password\",\n  \"name\": \"Gmail personal\",\n  \"service\": \"Gmail\",\n  \"tags\": [\"email\"],\n  \"payload\": {\n    \"password\": \"{{password}}\",\n    \"username\": \"{{username}}\"\n  }\n}",
